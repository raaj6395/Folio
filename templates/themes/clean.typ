#let theme = (
  page-bg: white,
  code-theme: auto,
  body-font: ("Inter",),
  heading-font: ("Inter",),
  mono-font: ("JetBrains Mono",),
  body-size: 10.5pt,
  heading-sizes: (20pt, 15pt, 12pt),
  leading: 0.62em,
  ink: rgb("#1d2433"),
  muted: rgb("#6b7280"),
  heading: rgb("#14213d"),
  accent: rgb("#2563eb"),
  rule: rgb("#d1d5db"),
  code-bg: rgb("#f4f5f7"),
  table-header: rgb("#e8edf7"),
  highlight: rgb("#fde68a"),
  callout: (
    note: (accent: rgb("#2563eb"), fill: rgb("#eff4ff"), label: "Note"),
    tip: (accent: rgb("#16a34a"), fill: rgb("#ecfdf3"), label: "Tip"),
    warning: (accent: rgb("#d97706"), fill: rgb("#fff7e8"), label: "Warning"),
    definition: (accent: rgb("#7c3aed"), fill: rgb("#f5f0ff"), label: "Definition"),
    key_point: (accent: rgb("#dc2626"), fill: rgb("#fef1f1"), label: "Key point"),
