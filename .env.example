# Postgres container (read by docker compose)
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio
POSTGRES_DB=folio

# Folio uses Postgres when this is set; unset = SQLite in FOLIO_HOME
FOLIO_DB_URL=postgres://folio:folio@localhost:5433/folio?sslmode=disable

# Postgres tests run only when this is set
FOLIO_TEST_DB_URL=postgres://folio:folio@localhost:5433/folio_test?sslmode=disable

# Listen address for `folio http` (loopback only while there is no auth)
FOLIO_HTTP_ADDR=127.0.0.1:8080

# Base URL used in links returned by tools (viewer, PDF download)
FOLIO_PUBLIC_URL=http://127.0.0.1:8080
